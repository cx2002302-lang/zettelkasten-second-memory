# 兼容测试环境环境变量示例
# 复制为 .env 后填入真实值。.env 已被 .gitignore 排除，切勿提交。

# ---------------------------------------------------------------------------
# LLM API Keys（至少填一个实际使用的）
# docker-compose.yml 通过 env_file 将本文件整体注入 4 个测试容器
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
# MiniMax 国内版 key（sk-cp- 前缀）；
# 在 OpenClaw latest 上由 deploy-zk-to-container.sh 自动配置 minimax-openai provider
MINIMAX_API_KEY=sk-cp-...
OPENROUTER_API_KEY=sk-or-...

# ---------------------------------------------------------------------------
# 版本固定（与生产环境保持一致）
# ---------------------------------------------------------------------------
# 生产 OpenClaw 版本（openclaw-prod-mirror）
OPENCLAW_PROD_VERSION=2026.4.24
# 生产 Hermes 版本（hermes-prod-mirror），本地固定 tag，见 make pin-hermes-prod
HERMES_PROD_TAG=0.17.0

# ---------------------------------------------------------------------------
# 其他
# ---------------------------------------------------------------------------
# Hermes 日志级别
HERMES_LOG_LEVEL=info
# OpenClaw latest（>= 2026.6.x）非 loopback 绑定需要显式 token
OPENCLAW_GATEWAY_TOKEN=testtoken-compat
