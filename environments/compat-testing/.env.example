# 兼容测试环境环境变量示例
# 复制为 .env 后填入真实值，.env 不提交到 Git

# LLM API Keys（至少填一个实际使用的）
# 更推荐放在项目仓库外部：/home/myxia/.openclaw/project/zettelkasten-secrets/<name>.env
# start-container.sh 会自动加载该目录下的 *.env
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
MINIMAX_API_KEY=sk-...
OPENROUTER_API_KEY=sk-...

# Hermes 日志级别
HERMES_LOG_LEVEL=info

# OpenClaw gateway token（latest 版本非 loopback 绑定需要）
OPENCLAW_GATEWAY_TOKEN=testtoken-compat
